// FishDock on Cloudflare Workers (the dashboard's "Import a repository" flow). Build: `npm run build`; deploy:
// `npx wrangler deploy`. The Pages set-up (functions/ + public/_routes.json) keeps working too; both run the same
// server/*.js code. Keys are added as secrets in the dashboard (Settings → Variables and Secrets), never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fishdock",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "fishdock"
  },
  "observability": { "enabled": true },
  // FishDock's own D1 database (never DetectDock's). The schema creates itself on the first request.
  // Fish Together: one Durable Object per party (SQLite-backed, which the Free plan supports), with hibernating sockets.
  // v1 was first applied by the production deploy of c104c95. Migrations only ever get added after it, never edited.
  "durable_objects": { "bindings": [{ "name": "PARTY", "class_name": "FishParty" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FishParty"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "fishdock", "database_id": "d6a8e717-4f54-460f-b5c4-6e6c55f206ba" }
  ],
  // ---- staging: a private test copy for trying a branch on a phone before it goes live ----
  // Deployed by its own Workers Build (project name "fishdock-staging", branch "staging", deploy command
  // `npx wrangler deploy --env staging`). Its own Worker, its own Fish Together objects and its own empty D1 database
  // (created on its first deploy; never the live one), at fishdock-staging.<account>.workers.dev. No keys: anything that
  // needs one says it isn't connected there.
  "env": {
    "staging": {
      "name": "fishdock-staging",
      "vars": { "FIREBASE_PROJECT_ID": "fishdock", "FISHDOCK_STAGING": "1" },
      "durable_objects": { "bindings": [{ "name": "PARTY", "class_name": "FishParty" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FishParty"] }],
      "d1_databases": [{ "binding": "DB", "database_name": "fishdock-staging" }]
    }
  }
}
