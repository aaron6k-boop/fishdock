// FishDock on Cloudflare Workers (the dashboard's "Import a repository" flow). Build: `npm run build`; deploy:
// `npx wrangler deploy`. The Pages set-up (functions/ + public/_routes.json) keeps working too; both run the same
// server/*.js code. Keys are added as secrets in the dashboard (Settings → Variables and Secrets), never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fishdock",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "fishdock"
  },
  "observability": { "enabled": true },
  // FishDock's own D1 database (never DetectDock's). The schema creates itself on the first request.
  "d1_databases": [
    { "binding": "DB", "database_name": "fishdock", "database_id": "d6a8e717-4f54-460f-b5c4-6e6c55f206ba" }
  ]
}
